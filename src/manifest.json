{
	"$schema": "https://raw.githubusercontent.com/BetterNCM/BetterNCM-Plugins/refs/heads/master/manifest-schema.json",
	"manifest_version": 1,
	"name": "西文字母片假名注音",
	"slug": "western-katakana",
	"version": "0.1.0",
	"author": "YXLEI0",
	"author_link": "https://github.com/YXLEI0",
	"description": "在日语歌歌词的拉丁字母 / 西里尔字母 / 希腊字母上方标注片假名读音（英文外来语、官方罗马音、法语 / 德语 / 拉丁语 / 俄语等西文语种都支持）",
	"preview": "preview.png",
	"type": "extension",
	"betterncm_version": ">=1.3.0",
	"ncm3-compatible": true,
	"requirements": [],
	"injects": {
		"Main": [
			{ "file": "core/latin.js" },
			{ "file": "core/dict.js" },
			{ "file": "core/enwords.js" },
			{ "file": "core/reading.js" },
			{ "file": "core/loan.js" },
			{ "file": "core/langs.js" },
			{ "file": "core/correct.js" },
			{ "file": "core/llm.js" },
			{ "file": "core/usage.js" },
			{ "file": "core/learn.js" },
			{ "file": "core/annotate.js" },
			{ "file": "main.js" }
		]
	}
}
